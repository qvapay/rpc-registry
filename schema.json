{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/qvapay/rpc-registry/main/schema.json",
  "title": "QvaPay RPC Registry",
  "type": "object",
  "required": ["version", "updated_at", "chains"],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string" },
    "version": { "type": "integer", "minimum": 1 },
    "updated_at": { "type": "string", "format": "date-time" },
    "chains": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": { "$ref": "#/$defs/chain" }
    }
  },
  "$defs": {
    "chain": {
      "type": "object",
      "required": ["kind", "name", "native", "explorer", "tokens", "rpcs"],
      "additionalProperties": false,
      "properties": {
        "kind": { "enum": ["evm", "tron", "btc"] },
        "chainId": { "type": "integer", "minimum": 1 },
        "name": { "type": "string", "minLength": 1 },
        "native": { "$ref": "#/$defs/asset" },
        "explorer": { "type": "string", "pattern": "^https://.*\\{tx\\}.*$" },
        "tokens": { "type": "array", "items": { "$ref": "#/$defs/token" } },
        "rpcs": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/rpc" } }
      },
      "allOf": [
        { "if": { "properties": { "kind": { "const": "evm" } } }, "then": { "required": ["chainId"] } }
      ]
    },
    "asset": {
      "type": "object",
      "required": ["symbol", "decimals"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 30 }
      }
    },
    "token": {
      "type": "object",
      "required": ["symbol", "address", "decimals"],
      "additionalProperties": false,
      "properties": {
        "symbol": { "type": "string", "minLength": 1 },
        "address": { "type": "string", "minLength": 20 },
        "decimals": { "type": "integer", "minimum": 0, "maximum": 30 }
      }
    },
    "rpc": {
      "type": "object",
      "required": ["url", "priority", "owner"],
      "additionalProperties": false,
      "properties": {
        "url": { "type": "string", "pattern": "^https://" },
        "priority": { "type": "integer", "minimum": 0, "maximum": 1000 },
        "owner": { "type": "string", "minLength": 1 },
        "enabled": { "type": "boolean", "default": true },
        "api": { "enum": ["jsonrpc", "trongrid", "esplora"] },
        "headers": { "type": "object", "additionalProperties": { "type": "string" } }
      }
    }
  }
}
